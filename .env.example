# =====================================================================
# Copia este archivo a ".env" y ajusta los valores.
# docker-compose lo lee automaticamente si esta en la raiz.
# =====================================================================

# ---- Puerto de la app (flexible, ver docs/CUSTOMIZE.md) ----
SERVER_PORT=8090

# ---- Perfil activo: h2 | mysql | postgres ----
SPRING_PROFILES_ACTIVE=h2

# ---- MySQL (docker-compose) ----
DB_HOST=mysql
DB_PORT=3306
DB_NAME=studentdb
DB_USER=root
DB_PASSWORD=root

# ---- Postgres (deploy cloud: Render/Railway/Koyeb) ----
# DATABASE_URL=jdbc:postgresql://host:5432/studentdb
# DB_USER=postgres
# DB_PASSWORD=postgres

# ---- Docker Hub ----
DOCKERHUB_USER=usuariodockerhub
PROMOTION=232
NUM=01
NOMBRE=nombre
APELLIDO=apellido
