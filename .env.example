# =====================================================================
# Copia este archivo a ".env" y ajusta los valores.
# docker-compose lo lee automaticamente si esta en la raiz.
# =====================================================================

# ---- Puerto de la app (flexible, ver docs/CUSTOMIZE.md) ----
SERVER_PORT=8090

# ---- Perfil activo: h2 | mysql | postgres ----
SPRING_PROFILES_ACTIVE=h2

# ---- CORS: origenes permitidos a llamar la API desde el navegador ----
# "*" = cualquier origen (comodo para el hackaton). En produccion pon el
# dominio real separado por comas, ej: http://localhost:4200,https://mi-front.com
CORS_ALLOWED_ORIGINS=*

# ---- MySQL (docker-compose) ----
DB_HOST=mysql
DB_PORT=3306
DB_NAME=studentdb
DB_USER=root
DB_PASSWORD=root

# ---- Postgres (deploy cloud: Render/Railway/Koyeb) ----
# DATABASE_URL=jdbc:postgresql://host:5432/studentdb
# DB_USER=postgres
# DB_PASSWORD=postgres

# ---- Docker Hub ----
DOCKERHUB_USER=usuariodockerhub
PROMOTION=232
NUM=01
NOMBRE=nombre
APELLIDO=apellido

# ---- Frontend (frontend/) ----
# Apunta el frontend a CUALQUIER backend (este repo u otro tuyo).
# Si el backend corre en tu maquina y el frontend en Docker, usa
# "http://host.docker.internal:PUERTO/..." en vez de "localhost".
FRONTEND_API_BASE_URL=http://localhost:8092/v1/api/student
FRONTEND_ID_FIELD=dni
FRONTEND_APP_TITLE=CRUD Student
